# Copy to .env and fill in only the integrations you actually use.
# DQI runs completely without any of these — every integration has a documented
# local/simulated fallback (see dqi_core/integrations/).

# --- Optional LLM-backed assistant (falls back to a deterministic local assistant) ---
ANTHROPIC_API_KEY=

# --- Optional real Kafka streaming (falls back to Simulation Mode) ---
KAFKA_BOOTSTRAP_SERVERS=

# --- Optional Jira ticket creation (returns "integration unavailable" without these) ---
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=DQI

# --- Optional PagerDuty alerting (returns "integration unavailable" without this) ---
PAGERDUTY_ROUTING_KEY=
